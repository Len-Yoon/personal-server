# DRAFT ONLY — NOT FOR APPLY.
# BLOCKED GATE: N100 `/mnt/c` currently reports 0777 under WSL. Do not replace
# placeholders or apply this template until path, UID/GID, free space, SQLite
# locking, filesystem semantics, and K3s runtime access are verified.
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: n100-local-draft
  annotations:
    draft.personal-server.io/not-for-apply: "true"
    draft.personal-server.io/purpose: "review-only static local PV contract"
    draft.personal-server.io/blocked-gate: "n100-native-storage-validation"
    draft.personal-server.io/candidate-path: "/var/lib/rancher/k3s/storage"
provisioner: kubernetes.io/no-provisioner
volumeBindingMode: WaitForFirstConsumer
reclaimPolicy: Retain
allowVolumeExpansion: false
---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: portal-web-files-draft
  annotations:
    draft.personal-server.io/not-for-apply: "true"
    draft.personal-server.io/confirm-required: "host path, node name, ownership, WSL mount suitability, single writer"
spec:
  capacity:
    storage: __CONFIRM_PORTAL_FILES_CAPACITY__
  volumeMode: Filesystem
  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Retain
  storageClassName: n100-local-draft
  local:
    path: __CONFIRM_N100_HOST_PATH__
  nodeAffinity:
    required:
      nodeSelectorTerms:
        - matchExpressions:
            - key: kubernetes.io/hostname
              operator: In
              values:
                - __CONFIRM_N100_NODE_NAME__
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: portal-web-files-draft
  namespace: personal-server
  annotations:
    draft.personal-server.io/not-for-apply: "true"
    draft.personal-server.io/confirm-required: "single-writer cutover and restored data validation"
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: n100-local-draft
  volumeName: portal-web-files-draft
  resources:
    requests:
      storage: __CONFIRM_PORTAL_FILES_CAPACITY__
---
# Candidate PVC contracts for the restricted first wave. No PV paths are
# supplied because the native ext4 candidate still requires validation.
apiVersion: v1
kind: ConfigMap
metadata:
  name: first-wave-pvc-contracts-draft
  namespace: personal-server
  annotations:
    draft.personal-server.io/not-for-apply: "true"
    draft.personal-server.io/blocked-gate: "n100-native-storage-validation"
    draft.personal-server.io/candidate-path: "/var/lib/rancher/k3s/storage"
data:
  candidates: |-
    portal-web: data/files -> portal-web-files-draft
    crawler-worker: data/crawler-worker -> crawler-worker-data-draft
    youtube-memo: data/youtube-memo -> youtube-memo-data-draft
    book-memo: data/book-memo -> book-memo-data-draft
  excluded: |-
    system-agent, homeops-executor, car-care-worker, caddy
