# DRAFT ONLY — NOT FOR APPLY.
# __CONFIRM_N100_HOST_PATH__ and __CONFIRM_N100_NODE_NAME__ must be replaced only
# after host path, UID/GID, free space, filesystem semantics, and WSL access are verified.
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: n100-local-draft
  annotations:
    draft.personal-server.io/not-for-apply: "true"
    draft.personal-server.io/purpose: "review-only static local PV contract"
provisioner: kubernetes.io/no-provisioner
volumeBindingMode: WaitForFirstConsumer
reclaimPolicy: Retain
allowVolumeExpansion: false
---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: portal-web-files-draft
  annotations:
    draft.personal-server.io/not-for-apply: "true"
    draft.personal-server.io/confirm-required: "hostPath, node name, ownership, WSL mount suitability"
spec:
  capacity:
    storage: __CONFIRM_PORTAL_FILES_CAPACITY__
  volumeMode: Filesystem
  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Retain
  storageClassName: n100-local-draft
  local:
    path: __CONFIRM_N100_HOST_PATH__
  nodeAffinity:
    required:
      nodeSelectorTerms:
        - matchExpressions:
            - key: kubernetes.io/hostname
              operator: In
              values:
                - __CONFIRM_N100_NODE_NAME__
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: portal-web-files-draft
  namespace: personal-server
  annotations:
    draft.personal-server.io/not-for-apply: "true"
    draft.personal-server.io/confirm-required: "single-writer cutover and restored data validation"
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: n100-local-draft
  volumeName: portal-web-files-draft
  resources:
    requests:
      storage: __CONFIRM_PORTAL_FILES_CAPACITY__
