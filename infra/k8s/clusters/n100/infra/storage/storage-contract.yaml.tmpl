# DRAFT ONLY — NOT FOR APPLY.
# K3s already provides the local-path StorageClass. This file records PVC
# contracts only; it intentionally does not define a StorageClass or PV.
# Provisioning uses the verified native-ext4 base path recorded in the
# transition document; no host path is embedded in this contract.
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: portal-web-files-dynamic-draft
  namespace: personal-server
  annotations:
    draft.personal-server.io/not-for-apply: "true"
    draft.personal-server.io/confirm-required: "capacity, data copy, single writer, restore check"
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: local-path
  resources:
    requests:
      storage: __CONFIRM_PORTAL_FILES_CAPACITY__
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: first-wave-pvc-contracts-draft
  namespace: personal-server
  annotations:
    draft.personal-server.io/not-for-apply: "true"
    draft.personal-server.io/confirm-required: "capacity, data copy, single writer, restore check"
data:
  candidates: |-
    portal-web: data/files -> portal-web-files-dynamic-draft (capacity=__CONFIRM_PORTAL_FILES_CAPACITY__)
    crawler-worker: data/crawler-worker -> crawler-worker-data-dynamic-draft (capacity=__CONFIRM_CRAWLER_DATA_CAPACITY__)
    youtube-memo: data/youtube-memo -> youtube-memo-data-dynamic-draft (capacity=__CONFIRM_YOUTUBE_DATA_CAPACITY__)
    book-memo: data/book-memo -> book-memo-data-dynamic-draft (capacity=__CONFIRM_BOOK_DATA_CAPACITY__)
  excluded: |-
    system-agent, homeops-executor, car-care-worker, caddy
