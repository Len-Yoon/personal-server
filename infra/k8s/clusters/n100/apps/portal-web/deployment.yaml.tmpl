# DRAFT ONLY — NOT FOR APPLY. Image, data copy, and runtime Secret injection require approval.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: portal-web
  namespace: personal-server
  annotations:
    draft.personal-server.io/not-for-apply: "true"
    draft.personal-server.io/confirm-required: "image digest, service account, data ownership, health endpoint"
spec:
  replicas: 0
  selector:
    matchLabels:
      app.kubernetes.io/name: portal-web
  template:
    metadata:
      labels:
        app.kubernetes.io/name: portal-web
      annotations:
        draft.personal-server.io/not-for-apply: "true"
    spec:
      containers:
        - name: portal-web
          image: __CONFIRM_PORTAL_IMAGE_REF__
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: 8000
          envFrom:
            - secretRef:
                name: portal-web-runtime
                optional: false
          env:
            - name: FILE_STORAGE_PATH
              value: /data/files
          volumeMounts:
            - name: portal-web-files
              mountPath: /data/files
              readOnly: false
          readinessProbe:
            httpGet:
              path: /health
              port: http
          livenessProbe:
            httpGet:
              path: /health
              port: http
      volumes:
        - name: portal-web-files
          persistentVolumeClaim:
            claimName: portal-web-files-dynamic-draft
