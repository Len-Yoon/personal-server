FROM @APP_BASE_IMAGE@
WORKDIR /opt/ha
RUN apk add --no-cache --upgrade 'musl>=1.2.6-r3' 'musl-utils>=1.2.6-r3' 'zlib>=1.3.2-r1'
RUN apk add --no-cache postgresql17-client \
    && pip install --no-cache-dir setuptools==84.0.0 wheel==0.48.0 \
    && pip install --no-cache-dir 'cryptography==50.0.0' 'psycopg[binary]==3.3.8'
RUN addgroup -S -g 10001 app && adduser -S -u 10001 -G app app
COPY _ha/ /opt/ha/
ENV PYTHONPATH=/opt/ha PYTHONDONTWRITEBYTECODE=1
USER 10001:10001
CMD ["python", "-m", "ha_runtime.backup_cli", "--help"]
