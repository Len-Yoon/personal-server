FROM @APP_BASE_IMAGE@
RUN apk add --no-cache --upgrade musl=1.2.6-r3 musl-utils=1.2.6-r3 zlib=1.4-r0 libssl3=3.5.9-r0 libcrypto3=3.5.9-r0 haproxy=3.4.7-r0 \
    && mkdir -p /usr/share/ha-ingress \
    && apk info -v | LC_ALL=C sort > /usr/share/ha-ingress/apk-inventory.txt
USER 10004:10004
ENTRYPOINT ["/usr/sbin/haproxy"]
CMD ["-W", "-db", "-f", "/etc/ha-ingress/haproxy.cfg"]
