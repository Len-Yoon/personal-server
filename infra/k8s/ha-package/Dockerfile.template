@ORIGINAL_ROOT_SECTION@
# Shared HA runtime is packaged but activation requires separately approved config.
RUN apk add --no-cache --upgrade 'musl>=1.2.6-r3' 'musl-utils>=1.2.6-r3' 'zlib>=1.3.2-r1' 'krb5-libs>=1.22.3-r0'
COPY _ha/ /opt/ha/
RUN pip install --no-cache-dir 'psycopg[binary]==3.3.8'
ENV PYTHONPATH=/opt/ha
@ORIGINAL_USER_SECTION@
